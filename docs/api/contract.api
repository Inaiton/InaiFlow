# ------------------------------------------------------------------ accounts: reports & dashboard
model TrialBalanceRow { kind: str  id: uuid  name: str  level: int  parent_id: uuid | null  opening_dr: decimal  opening_cr: decimal  debit: decimal  credit: decimal  closing_dr: decimal  closing_cr: decimal }
model TrialBalanceOut { date_from: date  date_to: date  rows: TrialBalanceRow[]  total_debit: decimal  total_credit: decimal  difference: decimal }
model StatementSection { label: str  amount: decimal  group_id: uuid | null  children: StatementSection[] }
model ProfitLossOut { date_from: date  date_to: date  trading_debit: StatementSection[]  trading_credit: StatementSection[]  gross_profit: decimal  pnl_debit: StatementSection[]  pnl_credit: StatementSection[]  net_profit: decimal  closing_stock: decimal  opening_stock: decimal }
model BalanceSheetOut { as_of: date  equity_and_liabilities: StatementSection[]  assets: StatementSection[]  total_liabilities: decimal  total_assets: decimal  difference: decimal }
model CashFlowOut { date_from: date  date_to: date  operating: StatementSection[]  investing: StatementSection[]  financing: StatementSection[]  net_change: decimal  opening_cash: decimal  closing_cash: decimal }
model RatioOut { key: str  label: str  value: decimal | null  formula: str }
model AgeingRow { ledger_id: uuid  party_name: str  total: decimal  buckets: map<decimal>  msme_overdue: bool }
model AgeingOut { kind: str  as_of: date  bucket_labels: str[]  rows: AgeingRow[]  totals: map<decimal> }
model BatchCostRow { period_run_id: uuid  run_title: str  period_month: date  stock_item_name: str | null  accepted_qty: decimal  rejected_qty: decimal  total_debit: decimal  total_credit: decimal  net_cost: decimal  unit_cost: decimal  status: str }
model KpiOut { key: str  label: str  value: decimal  change_pct: decimal | null }
model CashFlowPoint { month: str  inflow: decimal  outflow: decimal }
model AlertOut { severity: str  kind: str  message: str  link: str | null }
model AccountsDashboardOut { kpis: KpiOut[]  cash_flow: CashFlowPoint[]  alerts: AlertOut[]  recent_vouchers: VoucherSummary[] }
model ExceptionOut { kind: str  severity: str  message: str  entity_type: str  entity_id: uuid | null  link: str | null }

