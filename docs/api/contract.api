model OrgContextOut { org_id: uuid  legal_name: str  mailing_name: str | null  workspace_slug: str  logo_url: str | null  state_code: str  base_currency_code: str  base_currency_symbol: str  role_code: str  role_name: str  is_external: bool  is_owner: bool  permissions: map<Level>  enabled_modules: map<bool>  current_fy: FyOut  books_beginning_from: date  impersonation: ImpersonationInfo | null }
model OrgOut { id: uuid  workspace_slug: str  public_join_code: str  legal_name: str  mailing_name: str | null  address_line1: str  address_line2: str | null  city: str  state_code: str  state_name: str  pincode: str  country: str  base_currency_code: str  base_currency_symbol: str  fy_begins_from: date  books_beginning_from: date  contact_email: str  contact_phone: str  gst_reg_type: str  gstin: str | null  pan: str | null  tan: str | null  cin_or_udyam: str | null  epf_code: str | null  esic_code: str | null  industry_type: str  iso_standard: str | null  logo_url: str | null  stamp_url: str | null  org_status: str  created_at: datetime }
model OrgUpdateIn { legal_name?: str  mailing_name?: str | null  address_line1?: str  address_line2?: str | null  city?: str  state_code?: str  pincode?: str  contact_email?: email  contact_phone?: str  gst_reg_type?: str  gstin?: str | null  pan?: str | null  tan?: str | null  cin_or_udyam?: str | null  epf_code?: str | null  esic_code?: str | null  industry_type?: str  iso_standard?: str | null  logo_storage_key?: str | null  stamp_storage_key?: str | null }
