# ------------------------------------------------------------------ accounts: taxation
model GstTotals { taxable: decimal  cgst: decimal  sgst: decimal  igst: decimal  cess: decimal }
model GstSummaryOut { period: str  outward: GstTotals  inward_itc: GstTotals  rcm_liability: GstTotals  net_payable: GstTotals  voucher_count: int }
