model BillingOut { plan_code: str | null  plan_name: str | null  org_status: str  trial_ends_at: datetime | null  internal_seats_used: int  internal_seats_max: int  external_seats_used: int  external_seats_max: int  storage_used_bytes: int  storage_max_gb: int  enabled_modules: map<bool> }

