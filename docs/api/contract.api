model GstValidationIssue { voucher_id: uuid | null  voucher_number: str | null  severity: str  code: str  message: str }
model Gstr2bImportOut { import_id: uuid  period: str  invoices: int }
model ReconRow { gstin: str  supplier_name: str | null  invoice_no: str  invoice_date: date  taxable: decimal  tax: decimal  voucher_id: uuid | null  portal_taxable: decimal | null  portal_tax: decimal | null  difference: decimal | null }
