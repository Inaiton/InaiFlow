# ------------------------------------------------------------------ accounts: vouchers & inventory
enum VoucherStatus = REGULAR | OPTIONAL | MEMORANDUM | POST_DATED | CANCELLED
enum BillRefType = NEW_REF | AGAINST_REF | ADVANCE | ON_ACCOUNT
model BillAllocation { ref_type: BillRefType  ref_name: str  amount: decimal  due_date?: date | null }
model EntryIn { ledger_id: uuid  entry_type: DrCr  amount: decimal  cost_centre_id?: uuid | null  bill_allocations?: BillAllocation[]  instrument_no?: str | null  instrument_date?: date | null }
model InventoryIn { stock_item_id: uuid  godown_id: uuid  movement_type: str  quantity: decimal  rate: decimal  amount?: decimal  batch_number?: str | null  gst_rate?: decimal | null }
model GstIn { place_of_supply_state_code?: str | null  reverse_charge?: bool  is_export?: bool  is_sez?: bool }
model VoucherIn { voucher_type_id: uuid  voucher_date: date  party_ledger_id?: uuid | null  supplier_invoice_no?: str | null  supplier_invoice_date?: date | null  status?: VoucherStatus  narration?: str | null  entries: EntryIn[]  inventory?: InventoryIn[]  gst?: GstIn | null  linked_period_run_id?: uuid | null  linked_step_id?: uuid | null  attachment_document_ids?: uuid[]  edit_reason?: str | null }
model EntryOut { id: uuid  ledger_id: uuid  ledger_name: str  entry_type: DrCr  amount: decimal  cost_centre_id: uuid | null  cost_centre_name: str | null  bill_allocations: BillAllocation[]  instrument_no: str | null  instrument_date: date | null  bank_reconciliation_date: date | null }
model InventoryOut { id: uuid  stock_item_id: uuid  stock_item_name: str  uom: str  godown_id: uuid  godown_name: str  movement_type: str  quantity: decimal  rate: decimal  amount: decimal  batch_number: str | null  gst_rate: decimal | null }
model DocumentRef { id: uuid  title: str  file_mime_type: str | null }
model VoucherSummary { id: uuid  voucher_number: str  voucher_date: date  voucher_type_id: uuid  voucher_type_name: str  base_type: str  party_ledger_id: uuid | null  party_name: str | null  total_amount: decimal  status: VoucherStatus  narration: str | null  linked_period_run_id: uuid | null  created_at: datetime }
model VoucherOut extends VoucherSummary { supplier_invoice_no: str | null  supplier_invoice_date: date | null  gst_metadata: json | null  linked_step_id: uuid | null  entries: EntryOut[]  inventory: InventoryOut[]  attachments: DocumentRef[]  created_by_name: str  approved_by_name: str | null  cancel_reason: str | null  updated_at: datetime }
model CancelIn { reason: str }
model AttachDocumentIn { document_id: uuid }
model TaxLineIn { ledger_id: uuid  stock_item_id?: uuid | null  quantity?: decimal | null  rate?: decimal | null  amount: decimal  gst_rate?: decimal | null  hsn_sac_code?: str | null }
model ComputeTaxIn { voucher_type_id: uuid  voucher_date: date  party_ledger_id: uuid  lines: TaxLineIn[]  gst?: GstIn | null }
model TaxBreakup { hsn_sac_code: str | null  gst_rate: decimal  taxable: decimal  cgst: decimal  sgst: decimal  igst: decimal  cess: decimal }
model ComputeTaxOut { tax_split: str  taxable_total: decimal  cgst: decimal  sgst: decimal  igst: decimal  cess: decimal  round_off: decimal  invoice_total: decimal  breakup: TaxBreakup[]  suggested_entries: EntryIn[]  warnings: str[] }
model StockSummaryRow { stock_item_id: uuid  name: str  stock_group_name: str | null  uom: str  valuation_method: str  quantity: decimal  rate: decimal  value: decimal  reorder_level: decimal | null  below_reorder: bool }
model StockMovementOut { date: date  voucher_id: uuid  voucher_number: str  voucher_type: str  godown_name: str  inward_qty: decimal  outward_qty: decimal  rate: decimal  balance_qty: decimal  balance_value: decimal }

