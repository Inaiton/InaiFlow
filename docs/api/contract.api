# ------------------------------------------------------------------ accounts: banking
model BankAccountOut { ledger_id: uuid  name: str  bank_account: str | null  ifsc: str | null  book_balance: decimal  book_balance_type: DrCr  unreconciled_count: int  last_reconciled_on: date | null }
model ReconEntryOut { entry_id: uuid  voucher_id: uuid  voucher_number: str  voucher_type: str  voucher_date: date  particulars: str  debit: decimal  credit: decimal  instrument_no: str | null  instrument_date: date | null  bank_reconciliation_date: date | null }
