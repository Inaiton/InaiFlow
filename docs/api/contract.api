model TdsComputeOut { applicable: bool  section: str  rate: decimal  tds_amount: decimal  threshold_info: str  pan_available: bool }
model TdsSummaryRow { section: str  party_ledger_id: uuid  party_name: str  pan: str | null  amount_paid: decimal  tds_amount: decimal  deposited: bool }
model TdsChallanOut { month: str  due_date: date  by_section: json[]  total: decimal }
model TdsSectionOut { section: str  nature: str  threshold_single: decimal | null  threshold_annual: decimal | null  rate_individual: decimal  rate_company: decimal  rate_no_pan: decimal }

