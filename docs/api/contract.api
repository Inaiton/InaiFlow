# ------------------------------------------------------------------ operations
enum NodeShape = OVAL | RECTANGLE | DIAMOND | PARALLEL | TERMINATOR
enum Branch = PASS | REJECT | REWORK | DEFAULT
enum StepStatus = PENDING | ACTIVE | PASSED | REJECTED | SKIPPED | LOCKED
enum RunStatus = PLANNED | IN_PROGRESS | QC_HOLD | COMPLETED | CANCELLED
model QcField { key: str  label: str  type: str  unit?: str | null  nominal?: decimal | null  tol_minus?: decimal | null  tol_plus?: decimal | null  options?: str[]  required?: bool }
model PassCriteria { mode: str  expression?: str | null }
model NodeConfig { trigger?: str | null  assigned_role_code?: str | null  machine?: str | null  std_cycle_time_mins?: decimal | null  instrument_required?: bool  qc_fields?: QcField[]  pass_criteria?: PassCriteria | null  reject_action?: str | null  sop_document_id?: uuid | null  skippable?: bool  commit_godown_id?: uuid | null  report_template_id?: uuid | null  notes?: str | null }
model Position { x: decimal  y: decimal }
model WorkflowNode { id: str  shape: NodeShape  label: str  position: Position  config: NodeConfig }
model WorkflowEdge { id: str  source: str  target: str  branch: Branch  label?: str | null }
model WorkflowGraph { nodes: WorkflowNode[]  edges: WorkflowEdge[] }
model WorkflowSummary { id: uuid  template_key: uuid  name: str  description: str | null  version: int  status: str  stock_item_id: uuid | null  stock_item_name: str | null  iso_clause_ref: str | null  node_count: int  active_run_count: int  published_at: datetime | null  created_at: datetime }
model WorkflowOut extends WorkflowSummary { graph_definition: WorkflowGraph  created_by_name: str }
model WorkflowIn { name: str  description?: str | null  stock_item_id?: uuid | null  iso_clause_ref?: str | null  graph_definition?: WorkflowGraph | null  from_library_key?: str | null }
model WorkflowUpdateIn { name?: str  description?: str | null  stock_item_id?: uuid | null  iso_clause_ref?: str | null  graph_definition?: WorkflowGraph }
model ValidationIssue { node_id: str | null  edge_id: str | null  message: str }
model WorkflowValidationOut { valid: bool  errors: ValidationIssue[]  warnings: ValidationIssue[] }
model LibraryTemplateOut { key: str  name: str  description: str  iso_clause_ref: str | null  graph_definition: WorkflowGraph }
model ItemStatsOut { run_count: int  active_run_count: int  last_run_at: datetime | null  avg_yield_pct: decimal | null  avg_unit_cost: decimal | null }
model OpsItemOut extends StockItemOut { stats: ItemStatsOut  workflow_count: int }
model RunCreateIn { workflow_id: uuid  run_title?: str | null  period_month: date  planned_qty: decimal  stock_item_id?: uuid | null  start_now?: bool }
model QcReading { value: str | null  in_tolerance: bool | null  auto_filled: bool }
model StepOut { id: uuid  node_id: str  step_name: str  node_shape: NodeShape  sequence: int  status: StepStatus  input_qty: decimal  accepted_qty: decimal  rejected_qty: decimal  rework_qty: decimal  qc_measurements: map<QcReading>  branch_taken: str | null  quick_qc: bool  is_locked: bool  executed_by_name: str | null  executed_at: datetime | null  signed_off_by_name: str | null  signed_off_at: datetime | null  override_reason: str | null  skip_reason: str | null  notes: str | null  instrument_id: uuid | null  ncr_id: uuid | null  attachment_count: int }
model MoneyFlowLine { source: str  voucher_id: uuid | null  voucher_number: str | null  date: date  particulars: str  amount: decimal  step_id: uuid | null }
model MoneyFlowOut { debits: MoneyFlowLine[]  credits: MoneyFlowLine[]  total_debit: decimal  total_credit: decimal  net_cost: decimal  accepted_qty: decimal  unit_cost: decimal }
model RunSummary { id: uuid  run_title: str  period_month: date  status: RunStatus  planned_qty: decimal  accepted_qty: decimal  rejected_qty: decimal  rework_qty: decimal  yield_pct: decimal | null  computed_unit_cost: decimal  stock_item_id: uuid | null  stock_item_name: str | null  workflow_id: uuid  workflow_name: str  workflow_version: int  current_step_names: str[]  progress_pct: decimal  created_at: datetime }
model RunOut extends RunSummary { graph_snapshot: WorkflowGraph  steps: StepOut[]  money_flow: MoneyFlowOut  cost_centre_id: uuid | null  doc_folder_id: uuid | null  hold_reason: str | null  cancel_reason: str | null  started_at: datetime | null  completed_at: datetime | null  created_by_name: str }
model ReasonIn { reason: str }
model OptionalReasonIn { reason?: str | null }
model StepExecuteIn { input_qty: decimal  accepted_qty: decimal  rejected_qty: decimal  rework_qty?: decimal  measurements?: map<str>  quick_qc?: bool  instrument_id?: uuid | null  notes?: str | null  override_reason?: str | null  defect_description?: str | null }
model NcrOut { id: uuid  ncr_number: str  period_run_id: uuid | null  run_title: str | null  run_step_id: uuid | null  step_name: str | null  rejected_qty: decimal  defect_description: str  root_cause_analysis: str | null  corrective_action: str | null  preventive_action: str | null  verification_notes: str | null  source: str  status: str  assigned_to: uuid | null  assigned_to_name: str | null  closed_by_name: str | null  closed_at: datetime | null  created_at: datetime }
model StepExecuteOut { step: StepOut  run: RunSummary  activated_step_ids: uuid[]  ncr: NcrOut | null  stock_voucher_id: uuid | null }
model RunPostingIn { entry_type: DrCr  amount: decimal  ledger_id: uuid  contra_ledger_id: uuid  voucher_date: date  narration?: str | null  step_id?: uuid | null }
model RunPostingOut { voucher_id: uuid  money_flow: MoneyFlowOut }
model LinkVoucherIn { voucher_id: uuid  step_id?: uuid | null }
model NcrIn { period_run_id?: uuid | null  run_step_id?: uuid | null  rejected_qty: decimal  defect_description: str  assigned_to?: uuid | null }
model NcrUpdateIn { defect_description?: str  root_cause_analysis?: str | null  corrective_action?: str | null  preventive_action?: str | null  assigned_to?: uuid | null  status?: str }
model NcrCloseIn { verification_notes: str }
model InstrumentOut { id: uuid  instrument_code: str  name: str  location: str | null  range_spec: str | null  least_count: str | null  last_calibrated_date: date  next_due_date: date  status: str  days_to_due: int  certificate_doc_id: uuid | null }
model InstrumentIn { instrument_code: str  name: str  location?: str | null  range_spec?: str | null  least_count?: str | null  last_calibrated_date: date  next_due_date: date  certificate_doc_id?: uuid | null }
model CalibrateIn { calibrated_on: date  next_due_date: date  certificate_doc_id?: uuid | null }
model ChecklistItemOut { id: uuid  clause: str  title: str  description: str | null  status: str  evidence_document_ids: uuid[]  notes: str | null  updated_by_name: str | null  updated_at: datetime | null }
model ChecklistUpdateIn { status?: str  evidence_document_ids?: uuid[]  notes?: str | null }
model ClauseScore { clause: str  title: str  total: int  compliant: int  score_pct: decimal }
model ReadinessOut { score_pct: decimal  by_clause: ClauseScore[]  open_ncrs: int  expired_instruments: int }
model AuditorInviteIn { email: email  access_expires_at: datetime  stock_item_ids?: uuid[]  period_run_ids?: uuid[] }
model OpsDashboardOut { kpis: KpiOut[]  active_runs: RunSummary[]  open_ncrs: NcrOut[]  calibration_due: InstrumentOut[]  readiness_pct: decimal  yield_series: json[] }

