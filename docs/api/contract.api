# =====================================================================================
# InaiFlow API CONTRACT v1  — single source of truth (generate: python docs/api/gen_openapi.py)
# -------------------------------------------------------------------------------------
# Grammar
#   enum Name = A | B | C
#   model Name [extends Base] { field: type   field?: type (optional)   field: type | null (nullable) }
#   types: str int bool uuid date datetime decimal email json any  Name  Name[]  Page<Name>  map<type>
#          decimal = string "^-?\d+(\.\d{1,4})?$"  ;  month = string "YYYY-MM"
#   endpoint:  METHOD /path | auth | query | body | response
#     auth  : public | user | org <perm.key>:<LEVEL> | org member | admin <ROLE,ROLE|ANY> | cron
#             (`org …` = requires X-Organization-ID; `user` = authenticated user, no org header)
#     query : space separated `name?:type` (`?` = optional) or `-`
#     body  : Model | multipart | -
#     resp  : 204 | <status> Model | <status> Model[] | <status> Page<Model> | 200 file(mime[,mime])
#   Path params are uuid unless declared `{name:type}`. Base path /api/v1 is implicit.
#   All errors: Error model with ErrorCode. All list endpoints: limit (1..200, default 50), offset (default 0).
# =====================================================================================

# ------------------------------------------------------------------ common
enum Level = NONE | READ | WRITE | FULL
enum ErrorCode = VALIDATION_ERROR | UNAUTHENTICATED | TOKEN_EXPIRED | INVALID_CREDENTIALS | EMAIL_NOT_VERIFIED | MFA_REQUIRED | MFA_INVALID | MFA_SETUP_REQUIRED | ACCOUNT_SUSPENDED | RATE_LIMITED | FORBIDDEN | PERMISSION_DENIED | ORG_SUSPENDED | MEMBERSHIP_EXPIRED | NOT_FOUND | CONFLICT | ALREADY_EXISTS | INVALID_STATE | DOUBLE_ENTRY_IMBALANCE | PERIOD_LOCKED | LEDGER_IN_USE | SYSTEM_RECORD | STEP_LOCKED | STEP_NOT_ACTIVE | QTY_MISMATCH | INSTRUMENT_EXPIRED | WORKFLOW_INVALID | WORKFLOW_PUBLISHED | FOLDER_LOCKED | FOLDER_NOT_EMPTY | DOCUMENT_LOCKED | SEGREGATION_OF_DUTIES | UPLOAD_INCOMPLETE | FILE_TOO_LARGE | UNSUPPORTED_MEDIA | PAYROLL_NOT_READY | IP_NOT_ALLOWED | IDEMPOTENCY_CONFLICT | QUOTA_EXCEEDED | INTERNAL_ERROR

model ErrorBody { code: ErrorCode  message: str  details: json | null }
model Error { error: ErrorBody }
model OkOut { ok: bool }
model UploadTicket { upload_url: str  method: str  headers: map<str>  storage_key: str  expires_at: datetime }
model UploadRequest { file_name: str  content_type: str  size_bytes: int }
model SignedUrlOut { url: str  expires_at: datetime }
model AuditLogOut { id: uuid  module: str  action: str  entity_type: str  entity_id: uuid  actor_type: str  user_id: uuid | null  user_name: str | null  role_code: str  before_diff: json | null  after_diff: json | null  reason: str | null  ip_address: str | null  created_at: datetime }

# ------------------------------------------------------------------ platform / meta
model HealthOut { status: str  version: str  db: str }
model StateOut { code: str  name: str }
model PermissionKeyOut { key: str  label: str  description: str }
model PermissionModuleOut { module: str  label: str  keys: PermissionKeyOut[] }
model CronResultOut { orgs_processed: int  folders_created: int  instruments_updated: int  invitations_expired: int  memberships_expired: int }

GET  /health                          | public | - | - | 200 HealthOut
GET  /meta/states                     | public | - | - | 200 StateOut[]
GET  /meta/permission-keys            | public | - | - | 200 PermissionModuleOut[]
GET  /internal/cron/daily             | cron   | - | - | 200 CronResultOut

# ------------------------------------------------------------------ auth (user)
enum LoginStatus = OK | MFA_REQUIRED
model SignupIn { full_name: str  email: email  password: str }
model SignupOut { email: email  verification_required: bool }
model VerifyEmailIn { email: email  code: str }
model EmailIn { email: email }
model LoginIn { email: email  password: str  remember?: bool }
model TokenOut { access_token: str  token_type: str  expires_in: int }
model LoginOut { status: LoginStatus  token: TokenOut | null  mfa_token: str | null  user: MeOut | null }
model MfaVerifyIn { mfa_token: str  code: str }
model LoginSuccessOut { token: TokenOut  user: MeOut }
model PasswordResetIn { email: email  code: str  new_password: str }

POST /auth/signup                     | public | - | SignupIn | 201 SignupOut
POST /auth/verify-email               | public | - | VerifyEmailIn | 204
POST /auth/resend-verification        | public | - | EmailIn | 204
POST /auth/login                      | public | - | LoginIn | 200 LoginOut
POST /auth/mfa/verify                 | public | - | MfaVerifyIn | 200 LoginSuccessOut
POST /auth/refresh                    | public | - | - | 200 LoginSuccessOut
POST /auth/logout                     | public | - | - | 204
POST /auth/password/forgot            | public | - | EmailIn | 204
POST /auth/password/reset             | public | - | PasswordResetIn | 204
GET  /auth/oauth/google/start         | public | redirect_to?:str | - | 302
GET  /auth/oauth/google/callback      | public | code:str state:str | - | 302

# ------------------------------------------------------------------ me (personal space)
enum FilePurpose = AVATAR | SIGNATURE
model MeOut { id: uuid  email: email  full_name: str  mobile: str | null  professional_reg_no: str | null  avatar_url: str | null  signature_url: str | null  is_email_verified: bool  mfa_enabled: bool  created_at: datetime }
model MeUpdateIn { full_name?: str  mobile?: str | null  professional_reg_no?: str | null  avatar_storage_key?: str | null  signature_storage_key?: str | null }
model MeFileUploadIn { purpose: FilePurpose  content_type: str  size_bytes: int }
model PasswordChangeIn { current_password: str  new_password: str }
model MfaSetupOut { secret: str  otpauth_uri: str }
model MfaCodeIn { code: str }
model MfaDisableIn { password: str  code: str }
model RecoveryCodesOut { recovery_codes: str[] }
model SessionOut { id: uuid  user_agent: str | null  ip: str | null  created_at: datetime  last_used_at: datetime  expires_at: datetime  is_current: bool }
model MyOrgOut { org_id: uuid  legal_name: str  mailing_name: str | null  workspace_slug: str  public_join_code: str  logo_url: str | null  role_id: uuid  role_code: str  role_name: str  is_external: bool  membership_status: str  access_expires_at: datetime | null  org_status: str }
model InvitationForMeOut { id: uuid  org_id: uuid  org_name: str  role_name: str  invited_by_name: str | null  access_expires_at: datetime | null  expires_at: datetime  created_at: datetime }
model JoinRequestIn { join_code: str  message?: str | null }
model MyJoinRequestOut { id: uuid  org_name: str  public_join_code: str  status: str  message: str | null  created_at: datetime }
model OrgCreateIn { legal_name: str  mailing_name?: str | null  workspace_slug: str  address_line1: str  address_line2?: str | null  city: str  state_code: str  pincode: str  country?: str  fy_begins_from: date  books_beginning_from: date  contact_email: email  contact_phone: str  gst_reg_type: str  gstin?: str | null  pan?: str | null  tan?: str | null  cin_or_udyam?: str | null  epf_code?: str | null  esic_code?: str | null  industry_type: str  iso_standard?: str | null }

GET    /me                            | user | - | - | 200 MeOut
PATCH  /me                            | user | - | MeUpdateIn | 200 MeOut
POST   /me/files/upload-url           | user | - | MeFileUploadIn | 200 UploadTicket
POST   /me/password                   | user | - | PasswordChangeIn | 204
POST   /me/mfa/setup                  | user | - | - | 200 MfaSetupOut
POST   /me/mfa/enable                 | user | - | MfaCodeIn | 200 RecoveryCodesOut
POST   /me/mfa/disable                | user | - | MfaDisableIn | 204
POST   /me/mfa/recovery-codes         | user | - | MfaCodeIn | 200 RecoveryCodesOut
