model RoleIn { role_code: str  role_name: str  is_external_collaborator?: bool  permissions: map<Level> }
model RoleUpdateIn { role_name?: str  is_external_collaborator?: bool  permissions?: map<Level> }
model AclOut { id: uuid  subject_type: str  subject_id: uuid  subject_name: str  resource_type: str  resource_id: uuid  resource_name: str  access_level: Level  created_at: datetime }
