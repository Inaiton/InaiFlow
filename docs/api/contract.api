model InvitationIn { email: email  role_id: uuid  access_expires_at?: datetime | null  acl_grants?: AclGrantIn[] }
model InvitationOut { id: uuid  email: str  role_id: uuid  role_name: str  status: str  access_expires_at: datetime | null  expires_at: datetime  created_by_name: str | null  created_at: datetime }
model JoinRequestOut { id: uuid  user_id: uuid  full_name: str  email: str  is_email_verified: bool  professional_reg_no: str | null  message: str | null  status: str  created_at: datetime }
model JoinDecisionIn { role_id: uuid  access_expires_at?: datetime | null }
