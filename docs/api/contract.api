# ------------------------------------------------------------------ superadmin (separate auth, aud=inaiflow-admin)
enum AdminRole = SUPERADMIN | SUPPORT_ADMIN | BILLING_ADMIN
enum AdminLoginStatus = MFA_REQUIRED | MFA_SETUP_REQUIRED | PASSWORD_CHANGE_REQUIRED
model AdminLoginIn { email: email  password: str }
model AdminLoginOut { status: AdminLoginStatus  mfa_token: str  otpauth_uri: str | null }
model AdminMfaVerifyIn { mfa_token: str  code: str  new_password?: str | null }
model AdminMeOut { id: uuid  email: str  full_name: str  role: AdminRole  mfa_enabled: bool  last_login_at: datetime | null }
model AdminLoginSuccessOut { token: TokenOut  admin: AdminMeOut }
model AdminDashboardOut { orgs_total: int  orgs_active: int  orgs_trial: int  orgs_suspended: int  users_total: int  mrr_inr: decimal  active_runs: int  vouchers_today: int  storage_bytes: int  irp_health: str  signups_series: SignupPoint[]  recent_orgs: AdminOrgSummary[] }
model AdminOrgSummary { id: uuid  legal_name: str  workspace_slug: str  public_join_code: str  gstin: str | null  industry_type: str  state_code: str  org_status: str  plan_code: str | null  member_count: int  owner_email: str  created_at: datetime  trial_ends_at: datetime | null }
model AdminOrgDetail extends AdminOrgSummary { owner_user_id: uuid  owner_name: str  external_count: int  storage_used_bytes: int  quota_overrides: json  plan_id: uuid | null  contact_email: str  contact_phone: str  city: str  voucher_count: int  run_count: int }
enum LifecycleAction = ACTIVATE | SUSPEND | ARCHIVE | EXTEND_TRIAL
enum ImpersonationMode = READ_ONLY | FULL_SUPPORT
enum UserAction = SUSPEND | UNSUSPEND | RESET_MFA | VERIFY_EMAIL | REVOKE_SESSIONS
enum InvoiceStatus = DUE | PAID | VOID
enum OrgStatus = ACTIVE | TRIAL | SUSPENDED | ARCHIVED
model SignupPoint { date: date  count: int }
model LifecycleIn { action: LifecycleAction  reason: str  trial_days?: int | null }
model PlanChangeIn { plan_id: uuid  quota_overrides?: json  reason: str }
model TransferOwnerIn { new_owner_user_id: uuid  reason: str }
model ImpersonateIn { mode: ImpersonationMode  ticket_reference: str  reason: str }
model ImpersonateOut { session_id: uuid  token: str  expires_at: datetime  launch_url: str }
model AdminUserSummary { id: uuid  email: str  full_name: str  is_email_verified: bool  mfa_enabled: bool  is_suspended: bool  org_count: int  last_login_at: datetime | null  created_at: datetime }
model AdminMembershipOut { org_id: uuid  org_name: str  role_code: str  status: str  access_expires_at: datetime | null }
model AdminUserDetail extends AdminUserSummary { mobile: str | null  professional_reg_no: str | null  memberships: AdminMembershipOut[]  active_sessions: int }
model UserActionIn { action: UserAction  reason: str }
model ConfigOut { id: uuid  config_category: str  config_key: str  display_name: str  payload: json  version: int  is_active: bool  effective_from: date | null  updated_by_name: str | null  updated_at: datetime }
model ConfigIn { config_category: str  config_key: str  display_name: str  payload: json  effective_from?: date | null  reason: str }
model ConfigUpdateIn { display_name?: str  payload: json  is_active?: bool  effective_from?: date | null  reason: str }
model ConfigVersionOut { version: int  payload: json  effective_from: date | null  change_reason: str | null  created_by_name: str | null  created_at: datetime }
model ConfigPushIn { org_ids?: uuid[]  all_orgs?: bool  reason: str }
model ConfigPushOut { orgs_updated: int  orgs_skipped: int }
model PlanOut { id: uuid  plan_code: str  name: str  monthly_price_inr: decimal  annual_price_inr: decimal  max_internal_seats: int  max_external_collaborators: int  max_storage_gb: int  enabled_modules: map<bool>  is_active: bool  org_count: int  created_at: datetime }
model PlanIn { plan_code: str  name: str  monthly_price_inr: decimal  annual_price_inr: decimal  max_internal_seats: int  max_external_collaborators: int  max_storage_gb: int  enabled_modules: map<bool>  is_active?: bool  reason: str }
model PlanUpdateIn { name?: str  monthly_price_inr?: decimal  annual_price_inr?: decimal  max_internal_seats?: int  max_external_collaborators?: int  max_storage_gb?: int  enabled_modules?: map<bool>  is_active?: bool  reason: str }
model SubscriptionInvoiceOut { id: uuid  org_id: uuid  org_name: str  invoice_number: str  period_start: date  period_end: date  amount_inr: decimal  status: InvoiceStatus  paid_at: datetime | null  created_at: datetime }
model SubscriptionInvoiceIn { org_id: uuid  period_start: date  period_end: date  amount_inr: decimal  reason: str }
model InvoiceStatusIn { status: InvoiceStatus  reason: str }
model PlatformAuditOut { id: uuid  admin_id: uuid | null  admin_email: str | null  action: str  target_type: str  target_id: uuid | null  before_state: json | null  after_state: json | null  ip_address: str | null  created_at: datetime }
model AdminAccountOut { id: uuid  email: str  full_name: str  role: AdminRole  is_active: bool  mfa_enabled: bool  last_login_at: datetime | null  created_at: datetime }
model AdminAccountIn { email: email  full_name: str  role: AdminRole }
model AdminAccountCreatedOut { admin: AdminAccountOut  temporary_password: str }
model AdminAccountUpdateIn { role?: AdminRole  is_active?: bool  reason: str }
model AdminOrgMemberOut { user_id: uuid  full_name: str  email: str  role_code: str  status: str }
model SystemHealthOut { db: str  storage: str  email: str  tax_gateway: str  version: str  environment: str }

