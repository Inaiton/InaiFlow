enum ApprovalStatus = DRAFT | UNDER_REVIEW | APPROVED | OBSOLETE
model FolderOut { id: uuid  parent_folder_id: uuid | null  name: str  system_kind: str | null  fy_label: str | null  month_date: date | null  is_system_locked: bool  linked_period_run_id: uuid | null  child_count: int  document_count: int  created_at: datetime }
model FolderIn { parent_folder_id: uuid  name: str }
model FolderUpdateIn { name?: str  parent_folder_id?: uuid }
model EnsureMonthIn { month: date }
model ReportBlock { id: str  type: str  data: json }
model ReportContent { blocks: ReportBlock[] }
model DocumentSummary { id: uuid  folder_id: uuid  title: str  source_type: str  file_name: str | null  file_mime_type: str | null  file_size: int | null  upload_status: str  iso_doc_number: str | null  revision_no: int  approval_status: ApprovalStatus  linked_voucher_id: uuid | null  linked_period_run_id: uuid | null  linked_step_id: uuid | null  linked_stock_item_id: uuid | null  prepared_by_name: str  created_at: datetime  updated_at: datetime }
model DocumentOut extends DocumentSummary { rich_content: ReportContent | null  template_id: uuid | null  ocr_text: str | null  reviewed_by_name: str | null  review_comment: str | null  approved_by_name: str | null  approved_at: datetime | null  previous_revision_id: uuid | null  folder_path: str[]  can_delete: bool }
model DocUploadIn { folder_id: uuid  title: str  file_name: str  content_type: str  size_bytes: int  source_type?: str  iso_doc_number?: str | null  linked_voucher_id?: uuid | null  linked_period_run_id?: uuid | null  linked_step_id?: uuid | null  linked_stock_item_id?: uuid | null }
model DocUploadOut { document: DocumentOut  upload: UploadTicket }
model CompleteUploadIn { checksum_sha256?: str | null  ocr_text?: str | null }
model RenderContext { stock_item_id?: uuid | null  period_run_id?: uuid | null  step_id?: uuid | null  voucher_id?: uuid | null }
model DocCreateIn { folder_id: uuid  title: str  source_type: str  template_id?: uuid | null  rich_content?: ReportContent | null  context?: RenderContext | null  iso_doc_number?: str | null  linked_period_run_id?: uuid | null  linked_step_id?: uuid | null  linked_stock_item_id?: uuid | null  linked_voucher_id?: uuid | null }
model DocUpdateIn { title?: str  rich_content?: ReportContent | null  folder_id?: uuid  iso_doc_number?: str | null }
model TransitionIn { to: ApprovalStatus  comment?: str | null }
model ReviewIn { comment?: str | null }
model ReviseIn { file?: UploadRequest | null }
model ReviseOut { document: DocumentOut  upload: UploadTicket | null }
model TemplateOut { id: uuid  template_type: str  name: str  description: str | null  is_system_default: bool  content_schema: json  created_by_name: str | null  created_at: datetime }
model TemplateIn { template_type: str  name: str  description?: str | null  content_schema: json }
model TemplateUpdateIn { name?: str  description?: str | null  content_schema?: json }
