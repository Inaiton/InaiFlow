# ------------------------------------------------------------------ accounts: masters
enum Nature = ASSETS | LIABILITIES | INCOME | EXPENSES
enum DrCr = DR | CR
model GroupOut { id: uuid  name: str  parent_group_id: uuid | null  nature: Nature  affects_gross_profit: bool  is_system_group: bool  system_code: str | null }
model GroupIn { name: str  parent_group_id: uuid }
model GroupUpdateIn { name?: str  parent_group_id?: uuid }
model PartyDetails { gstin?: str | null  state_code?: str | null  pan?: str | null  msme_type?: str | null  udyam_no?: str | null  bank_account?: str | null  ifsc?: str | null  address?: str | null  email?: str | null  phone?: str | null  is_sez?: bool  is_unregistered?: bool  deductee_type?: str | null }
model TaxConfig { tax_type: str  gst_head?: str | null  rate?: decimal | null  tds_section?: str | null }
model InterestConfig { rate_pct: decimal  basis: str  grace_days?: int }
model LedgerOut { id: uuid  group_id: uuid  group_name: str  nature: Nature  name: str  alias: str | null  system_code: str | null  currency_code: str  opening_balance: decimal  opening_balance_type: DrCr  maintain_bill_by_bill: bool  default_credit_days: int | null  credit_limit: decimal | null  party_details: PartyDetails | null  tax_config: TaxConfig | null  interest_config: InterestConfig | null  is_active: bool  closing_balance: decimal  closing_balance_type: DrCr  created_at: datetime }
model LedgerIn { group_id: uuid  name: str  alias?: str | null  currency_code?: str  opening_balance?: decimal  opening_balance_type?: DrCr  maintain_bill_by_bill?: bool  default_credit_days?: int | null  credit_limit?: decimal | null  party_details?: PartyDetails | null  tax_config?: TaxConfig | null  interest_config?: InterestConfig | null  is_active?: bool }
model LedgerStatementLine { date: date  voucher_id: uuid  voucher_number: str  voucher_type: str  particulars: str  narration: str | null  debit: decimal  credit: decimal  running_balance: decimal  running_type: DrCr }
model LedgerStatementOut { ledger: LedgerOut  date_from: date  date_to: date  opening_balance: decimal  opening_type: DrCr  lines: LedgerStatementLine[]  total_debit: decimal  total_credit: decimal  closing_balance: decimal  closing_type: DrCr }
model OutstandingBillOut { ref_name: str  bill_date: date  due_date: date | null  amount: decimal  pending: decimal  pending_type: DrCr  overdue_days: int }
model CostCentreOut { id: uuid  category_name: str  name: str  parent_id: uuid | null  linked_period_run_id: uuid | null  budget_amount: decimal | null  actual_amount: decimal }
model CostCentreIn { category_name?: str  name: str  parent_id?: uuid | null  budget_amount?: decimal | null }
model VoucherTypeOut { id: uuid  name: str  base_type: str  is_accounting: bool  is_system: bool  shortcut: str | null  numbering_method: str  prefix: str  suffix: str  zero_padding: int  next_number: int }
model VoucherTypeIn { name: str  base_type: str  numbering_method?: str  prefix?: str  suffix?: str  zero_padding?: int  next_number?: int }
model VoucherTypeUpdateIn { name?: str  numbering_method?: str  prefix?: str  suffix?: str  zero_padding?: int  next_number?: int }
model CurrencyOut { id: uuid  code: str  symbol: str  name: str  decimal_places: int  latest_rate: decimal | null  latest_rate_date: date | null }
model CurrencyIn { code: str  symbol: str  name: str  decimal_places?: int }
model ExchangeRateIn { rate_date: date  rate_to_base: decimal }
model GodownOut { id: uuid  name: str  parent_godown_id: uuid | null  godown_type: str  is_system: bool }
model GodownIn { name: str  parent_godown_id?: uuid | null  godown_type?: str }
model StockGroupOut { id: uuid  name: str  parent_id: uuid | null }
model StockGroupIn { name: str  parent_id?: uuid | null }
model BomComponent { raw_item_id: uuid  qty_per_unit: decimal  scrap_pct: decimal }
model StockItemOut { id: uuid  target_type: str  name: str  sku_code: str | null  stock_group_id: uuid | null  stock_group_name: str | null  uom_primary: str  uom_alternate: str | null  uom_conversion_factor: decimal | null  valuation_method: str  hsn_sac_code: str | null  gst_rate: decimal  opening_qty: decimal  opening_rate: decimal  reorder_level: decimal | null  diagram_url: str | null  custom_fields: json  bom_components: BomComponent[]  closing_qty: decimal  closing_value: decimal  created_at: datetime }
model StockItemIn { target_type?: str  name: str  sku_code?: str | null  stock_group_id?: uuid | null  uom_primary?: str  uom_alternate?: str | null  uom_conversion_factor?: decimal | null  valuation_method?: str  hsn_sac_code?: str | null  gst_rate?: decimal  opening_qty?: decimal  opening_rate?: decimal  reorder_level?: decimal | null  diagram_storage_key?: str | null  custom_fields?: json  bom_components?: BomComponent[] }
