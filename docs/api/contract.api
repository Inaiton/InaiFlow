POST   /me/invitations/{invitation_id}/accept  | user | - | - | 200 MyOrgOut
POST   /me/invitations/{invitation_id}/decline | user | - | - | 204
GET    /me/join-requests              | user | - | - | 200 MyJoinRequestOut[]
POST   /me/join-requests              | user | - | JoinRequestIn | 201 MyJoinRequestOut
DELETE /me/join-requests/{request_id} | user | - | - | 204
POST   /organizations                 | user | - | OrgCreateIn | 201 MyOrgOut
GET    /organizations/check-slug      | user | slug:str | - | 200 OkOut

