# Copy to server/.env for local development. Production refuses default/short (<32 byte) secrets.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://inaiflow_owner:inaiflow_owner@localhost:5432/inaiflow_dev
# Supabase: app uses the transaction pooler (6543, NullPool, no statement cache); migrations the session pooler (5432)
DATABASE_URL_MIGRATIONS=
DB_NULLPOOL=0
JWT_SECRET=change-me-to-32-plus-random-bytes-user
ADMIN_JWT_SECRET=change-me-to-32-plus-random-bytes-admin
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
CRON_SECRET=change-me
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PUBLIC_USER_WEB_URL=http://localhost:3000
PUBLIC_ADMIN_WEB_URL=http://localhost:3001
PUBLIC_API_URL=
TRUST_PROXY_HEADERS=0
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=inaiflow-private
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=InaiFlow <no-reply@example.com>
TAX_GATEWAY=mock
ADMIN_IP_ALLOWLIST=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
