# Modules may import app.core / app.adapters / app.seeds, their own package, and ONLY the interface.py
# of other modules. One contract per module (direct imports only).
[importlinter]
root_packages =
    app

[importlinter:contract:core-independent]
name = core, adapters and seeds never import modules or the app
type = forbidden
source_modules =
    app.core
    app.adapters
    app.seeds
forbidden_modules =
    app.modules
    app.main
    app.cli

[importlinter:contract:identity-private]
name = only app.modules.identity.interface may be imported by other modules
type = forbidden
source_modules =
    app.modules.organization
    app.modules.rbac
    app.modules.platform
    app.modules.accounts
    app.modules.taxation
    app.modules.payroll
    app.modules.operations
    app.modules.documents
    app.modules.superadmin
forbidden_modules =
    app.modules.identity
ignore_imports =
    app.modules.** -> app.modules.identity.interface
allow_indirect_imports = True
unmatched_ignore_imports_alerting = none

